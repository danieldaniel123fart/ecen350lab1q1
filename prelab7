`timescale 1ns/1ps

module SC_Control_tb;

reg [10:0] opcode;

wire Reg2Loc, ALUSrc, MemtoReg, RegWrite;
wire MemRead, MemWrite, Branch, Uncondbranch;
wire [3:0] ALUOp;
wire [1:0] SignOp;

integer tests, errors, i;
reg [10:0] random_opcode;

// Instantiate the control unit
SC_Control dut (
    .Reg2Loc(Reg2Loc),
    .ALUSrc(ALUSrc),
    .MemtoReg(MemtoReg),
    .RegWrite(RegWrite),
    .MemRead(MemRead),
    .MemWrite(MemWrite),
    .Branch(Branch),
    .Uncondbranch(Uncondbranch),
    .ALUOp(ALUOp),
    .SignOp(SignOp),
    .opcode(opcode)
);

// Compare actual outputs against expected outputs
task check;
    input [10:0] op;
    input [7:0] flags;
    input [3:0] alu;
    input [1:0] sign;

    reg [13:0] actual, expected;

    begin
        opcode = op;
        #10;

        actual = {Reg2Loc, ALUSrc, MemtoReg,
                  RegWrite, MemRead, MemWrite,
                  Branch, Uncondbranch, ALUOp, SignOp};

        expected = {flags, alu, sign};

        tests = tests + 1;

        if (actual !== expected) begin
            errors = errors + 1;
            $display("ERROR opcode=%b expected=%b actual=%b",
                     op, expected, actual);
        end
    end
endtask

// Identify supported opcodes
function supported;
    input [10:0] op;
    begin
        supported = 1'b1;
        casez (op)
            11'b11111000010,
            11'b11111000000,
            11'b10001011000,
            11'b11001011000,
            11'b10001010000,
            11'b10101010000,
            11'b1001000100?,
            11'b1101000100?,
            11'b10110100???,
            11'b000101?????: supported = 1'b1;
            default: supported = 1'b0;
        endcase
    end
endfunction

initial begin
    tests = 0;
    errors = 0;
    opcode = 0;

    // Create VCD waveform dump
    $dumpfile("SC_Control_tb.vcd");
    $dumpvars(0, SC_Control_tb);

    // Test fixed opcodes
    check(11'b11111000010, 8'b01111000, 4'b0010, 2'b01); // LDUR
    check(11'b11111000000, 8'b11000100, 4'b0010, 2'b01); // STUR
    check(11'b10001011000, 8'b00010000, 4'b0010, 2'b00); // ADD
    check(11'b11001011000, 8'b00010000, 4'b0110, 2'b00); // SUB
    check(11'b10001010000, 8'b00010000, 4'b0000, 2'b00); // AND
    check(11'b10101010000, 8'b00010000, 4'b0001, 2'b00); // ORR

    // Test every ADD immediate variation
    for (i = 0; i < 2; i = i + 1)
        check(11'b10010001000 + i,
              8'b01010000, 4'b0010, 2'b00);

    // Test every SUB immediate variation
    for (i = 0; i < 2; i = i + 1)
        check(11'b11010001000 + i,
              8'b01010000, 4'b0110, 2'b00);

    // Test all 8 CBZ variations
    for (i = 0; i < 8; i = i + 1)
        check(11'b10110100000 + i,
              8'b10000010, 4'b0111, 2'b10);

    // Test all 32 B variations
    for (i = 0; i < 32; i = i + 1)
        check(11'b00010100000 + i,
              8'b00000001, 4'b0000, 2'b11);

    // Test 10 random unsupported opcodes
    for (i = 0; i < 10; i = i + 1) begin
        random_opcode = $random & 11'h7FF;

        while (supported(random_opcode))
            random_opcode = $random & 11'h7FF;

        check(random_opcode,
              8'b00000000, 4'b0000, 2'b00);
    end

    // Display final results
    $display("Total tests: %0d", tests);
    $display("Total errors: %0d", errors);

    if (errors == 0)
        $display("ALL TESTS PASSED");
    else
        $display("TESTBENCH FAILED");

    $finish;
end

endmodule

