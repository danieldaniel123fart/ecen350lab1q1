`define OPCODE_CBZ    11'b10110100???

`define OPCODE_LDUR   11'b11111000010
`define OPCODE_STUR   11'b11111000000

module SC_Control(
    output reg       Reg2Loc,
    output reg       ALUSrc,
    output reg       MemtoReg,
    output reg       RegWrite,
    output reg       MemRead,
    output reg       MemWrite,
    output reg       Branch,
    output reg       Uncondbranch,
    output reg [3:0] ALUOp,
    output reg [1:0] SignOp,
    input [10:0]     opcode
);

always @(*) begin
    // Default: all control signals zero.
    // Prevents latches and handles invalid opcodes.
    Reg2Loc      = 1'b0;
    ALUSrc       = 1'b0;
    MemtoReg     = 1'b0;
    RegWrite     = 1'b0;
    MemRead      = 1'b0;
    MemWrite     = 1'b0;
    Branch       = 1'b0;
    Uncondbranch = 1'b0;
    ALUOp        = 4'b0000;
    SignOp       = 2'b00;

    casez (opcode)

        `OPCODE_LDUR: begin
            SignOp   = 2'b01;
            ALUSrc   = 1'b1;
            MemRead  = 1'b1;
            MemtoReg = 1'b1;
            RegWrite = 1'b1;
            ALUOp    = 4'b0010;
        end

        `OPCODE_STUR: begin
            SignOp   = 2'b01;
            Reg2Loc  = 1'b1;
            ALUSrc   = 1'b1;
            MemWrite = 1'b1;
            ALUOp    = 4'b0010;
        end

        `OPCODE_ADDREG: begin
            RegWrite = 1'b1;
            ALUOp    = 4'b0010;
        end

        `OPCODE_SUBREG: begin
            RegWrite = 1'b1;
            ALUOp    = 4'b0110;
        end

        `OPCODE_ADDIMM: begin
            ALUSrc   = 1'b1;
            RegWrite = 1'b1;
            ALUOp    = 4'b0010;
        end

        `OPCODE_SUBIMM: begin
            ALUSrc   = 1'b1;
            RegWrite = 1'b1;
            ALUOp    = 4'b0110;
        end

        `OPCODE_ANDREG: begin
            RegWrite = 1'b1;
            ALUOp    = 4'b0000;
        end

        `OPCODE_ORRREG: begin
            RegWrite = 1'b1;
            ALUOp    = 4'b0001;
        end

        `OPCODE_CBZ: begin
            SignOp   = 2'b10;
            Reg2Loc  = 1'b1;
            Branch   = 1'b1;
            ALUOp    = 4'b0111;
        end

        `OPCODE_B: begin
            SignOp       = 2'b11;
            Uncondbranch = 1'b1;
        end

        default: begin
            // Unsupported instruction: outputs stay zero
        end

    endcase
end

endmodule

